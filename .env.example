FLASK_DEBUG=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackathon_db
DATABASE_NAME=hackathon_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/RESTOFURLHERE
APP_URL=appurlhere
REDIS_URL=redis://redis:6379/0
KAFKA_BROKER=kafka:9092
# Semantic search (pgvector) + RAG Q&A via OpenRouter free models.
# No key = /search and /ask answer 503; URL creation is unaffected.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
# Retrieval knobs: top-k default is per-request (k=1..20); ask cache TTL (s).
ASK_CACHE_TTL=600
# Optional ranking attribution headers sent to OpenRouter.
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_APP_TITLE=QuadroURL
# GF_ADMIN_USER=admin
# GF_ADMIN_PASSWORD=change-me-in-your-local-env
