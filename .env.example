FLASK_DEBUG=true
DATABASE_NAME=hackathon_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DISCORD_WEBHOOK_URL=
APP_URL=http://127.0.0.1:8000
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_ALLOWED_ORIGINS=http://127.0.0.1:8000
ADMIN_BOOTSTRAP_TOKEN=
TRUSTED_PROXY_COUNT=0
MAX_REQUEST_BODY_BYTES=6291456
REDIS_URL=redis://redis:6379/0
KAFKA_BROKER=kafka:9092
# Destination reputation checks. "disabled" is the default; "google" opts in.
# Verdicts (safe and unsafe) are cached for SAFE_BROWSING_CACHE_TTL seconds and
# keyed on a URL hash, so a redirect is a cache read, not a provider call.
# SAFE_BROWSING_FAILURE_POLICY=closed fails a redirect closed when the provider
# is unreachable; "open" fails open. Set the TTL to 0 to disable caching.
SAFE_BROWSING_PROVIDER=disabled
SAFE_BROWSING_API_KEY=
SAFE_BROWSING_CACHE_TTL=3600
SAFE_BROWSING_FAILURE_POLICY=closed
# Semantic search (pgvector) + RAG Q&A via OpenRouter free models.
# No key = /search and /ask answer 503; URL creation is unaffected.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
# Retrieval knobs: top-k default is per-request (k=1..20); ask cache TTL (s).
ASK_CACHE_TTL=600
# Optional ranking attribution headers sent to OpenRouter.
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_APP_TITLE=QuadroURL
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=local-only-change-me
