# Never ship the local dev environment into images: a macOS-linked .venv
# copied over the image's Linux venv breaks `uv run` at container start
# (uv recreates the venv empty, so app deps like peewee go missing).
.git/
.github/
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.tox/
**/.tox/
.coverage
.coverage.*
**/.coverage
**/.coverage.*
coverage.xml
**/coverage.xml
htmlcov/
**/htmlcov/
coverage/
**/coverage/
test-results/
**/test-results/
playwright-report/
**/playwright-report/
loadtests/
**/loadtests/
node_modules/
**/node_modules/
dist/
**/dist/
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example
.terraform/
**/.terraform/
.terraform.lock.hcl
**/.terraform.lock.hcl
.terraform.tfstate.lock.info
**/.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
terraform.tfstate.d/
**/terraform.tfstate.d/
*.tfvars
*.tfvars.json
**/*.tfvars
**/*.tfvars.json
deploy/
docs/
scripts/
data/
grafana/
nginx/
prometheus/
promtail/
client/
tests/
.agents/
judging/
docker-compose*.yml
docker-compose*.yaml
*.log
**/*.log
*.pem
**/*.pem
*.key
**/*.key
